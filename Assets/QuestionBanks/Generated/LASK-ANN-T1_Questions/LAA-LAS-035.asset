  m_Name: LAA-LAS-035
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-035
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 20 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 10
    mg/kg yht\xE4 annosta kohden. Nestem\xE4isen l\xE4\xE4kkeen vahvuus on 40 mg/ml.
    Kuinka monta millilitraa annat?"
  options:
  - 2 ml
  - 4 ml
  - 5 ml
  - 8 ml
  infoBubble: "Laske ensin painon mukainen l\xE4\xE4keainem\xE4\xE4r\xE4 milligrammoina.
    Muuta se sen j\xE4lkeen annettavaksi tilavuudeksi l\xE4\xE4kkeen vahvuuden avulla."
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Selvit\xE4 ensin potilaalle tarvittava l\xE4\xE4keainem\xE4\xE4r\xE4
    ja k\xE4yt\xE4 vasta sen j\xE4lkeen l\xE4\xE4kkeen vahvuutta millilitram\xE4\xE4r\xE4n
    laskemiseen."
  rationale: "Annos on 20 kg \xD7 10 mg/kg = 200 mg. Tarvittava tilavuus on 200 mg
    \xF7 40 mg/ml = 5 ml."
  professionalPatch: "Painoperusteisessa nestem\xE4isen l\xE4\xE4kkeen laskussa etenemisj\xE4rjestys
    on usein kg \u2192 mg \u2192 ml."
