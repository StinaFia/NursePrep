  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-010
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-010
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 0,75 g vuorokaudessa
    jaettuna kolmeen yht\xE4 suureen annokseen. K\xE4ytett\xE4viss\xE4 on 125 mg:n
    tabletteja. Kuinka monta tablettia potilas saa yhdell\xE4 antokerralla?"
  options:
  - 1 tabletti
  - 2 tablettia
  - 3 tablettia
  - 6 tablettia
  infoBubble: "Muunna ensin vuorokausiannos milligrammoiksi. Jaa se sitten kolmeen
    yht\xE4 suureen annokseen ja laske yhden annoksen tablettim\xE4\xE4r\xE4."
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Teht\xE4v\xE4ss\xE4 on useampi vaihe. Tarkista ensin yksikk\xF6,
    laske sitten yhden antokerran l\xE4\xE4keainem\xE4\xE4r\xE4 ja vasta lopuksi
    tablettim\xE4\xE4r\xE4."
  rationale: "0,75 g = 750 mg. Yksi annos: 750 mg \xF7 3 = 250 mg. Tablettim\xE4\xE4r\xE4:
    250 mg \xF7 125 mg/tabletti = 2 tablettia."
  professionalPatch: "Kirjoita monivaiheisen l\xE4\xE4kelaskun v\xE4litulokset n\xE4kyviin.
    Se helpottaa sek\xE4 laskemista ett\xE4 oman vastauksen tarkistamista."
