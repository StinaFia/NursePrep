  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-080
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-080
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 40 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 15
    mg/kg/vrk jaettuna nelj\xE4\xE4n yht\xE4 suureen annokseen. Nestem\xE4isen l\xE4\xE4kkeen
    vahvuus on 25 mg/ml. Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 1,5 ml
  - 4 ml
  - 6 ml
  - 10 ml
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: Erota toisistaan painon perusteella laskettava vuorokausiannos,
    yhden antokerran annos ja lopuksi annettava tilavuus.
  rationale: "Vuorokausiannos on 40 kg \xD7 15 mg/kg/vrk = 600 mg/vrk. Yhden antokerran
    annos on 600 mg \xF7 4 = 150 mg. Tarvittava tilavuus on 150 mg \xF7 25 mg/ml
    = 6 ml."
  professionalPatch: "Monivaiheinen lasku kannattaa pilkkoa osiin: selvit\xE4 ensin
    mit\xE4 potilas tarvitsee, sitten yksi antokerta ja vasta lopuksi annettava m\xE4\xE4r\xE4."
