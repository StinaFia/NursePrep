  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-071
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1,5 g. K\xE4ytett\xE4viss\xE4
    on 500 mg:n tabletteja. Kuinka monta tablettia annat?"
  options:
  - 2 tablettia
  - 3 tablettia
  - 5 tablettia
  - 0,3 tablettia
  infoBubble: "Ovatko m\xE4\xE4r\xE4ys ja tabletin vahvuus samassa yksik\xF6ss\xE4?"
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Tarkista ennen laskemista, ovatko m\xE4\xE4r\xE4tty annos ja
    tabletin vahvuus samassa yksik\xF6ss\xE4."
  rationale: "1,5 g = 1 500 mg. Tarvittava tablettim\xE4\xE4r\xE4 on 1 500 mg \xF7
    500 mg/tabletti = 3 tablettia."
  professionalPatch: "Yhten\xE4ist\xE4 yksik\xF6t ennen varsinaista l\xE4\xE4kelaskua."
