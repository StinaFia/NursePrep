  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-096
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-096
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle annetaan l\xE4\xE4kett\xE4 30 mg kaksi kertaa vuorokaudessa.
    L\xE4\xE4kkeen vahvuus on 20 mg/ml. Valmisteen annostelijalla 1 ml = 20 tippaa.
    Kuinka monta tippaa potilas saa yhteens\xE4 vuorokaudessa?"
  options:
  - 30 tippaa
  - 40 tippaa
  - 60 tippaa
  - 80 tippaa
  infoBubble: "J\xE4senn\xE4 lasku vaiheisiin. Millainen tilavuus vastaa yht\xE4
    l\xE4\xE4keannosta, ja mit\xE4 kysyt\xE4\xE4n koko vuorokaudelta?"
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Ratkaise ensin yksi annos ja huomioi vasta sen j\xE4lkeen vuorokauden
    antokertojen m\xE4\xE4r\xE4."
  rationale: "Yhteen annokseen tarvitaan 30 mg \xF7 20 mg/ml = 1,5 ml. Se vastaa
    1,5 ml \xD7 20 tippaa/ml = 30 tippaa. Annoksia on kaksi, joten 30 tippaa \xD7
    2 = 60 tippaa/vrk."
  professionalPatch: "Monivaiheisessa tippalaskussa seuraa yksik\xF6it\xE4: mg \u2192
    ml \u2192 tipat \u2192 tarvittaessa vuorokauden kokonaism\xE4\xE4r\xE4."
