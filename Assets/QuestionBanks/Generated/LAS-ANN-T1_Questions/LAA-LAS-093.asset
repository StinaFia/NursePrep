  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-093
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-093
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilas painaa 30 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 12
    mg/kg/vrk jaettuna kolmeen yht\xE4 suureen annokseen. L\xE4\xE4kkeen vahvuus
    on 40 mg/ml. Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 3 ml
  - 4 ml
  - 6 ml
  - 9 ml
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Etene painoperusteisesta vuorokausiannoksesta yhden antokerran
    l\xE4\xE4keainem\xE4\xE4r\xE4\xE4n ja vasta sitten tilavuuteen."
  rationale: "Vuorokausiannos on 30 kg \xD7 12 mg/kg/vrk = 360 mg/vrk. Yksi annos
    on 360 mg \xF7 3 = 120 mg. Tarvittava tilavuus on 120 mg \xF7 40 mg/ml = 3 ml."
  professionalPatch: "Pid\xE4 jokaisessa v\xE4livaiheessa yksikk\xF6 mukana. Se auttaa
    n\xE4kem\xE4\xE4n, mit\xE4 olet jo ratkaissut ja mit\xE4 viel\xE4 puuttuu."
