  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-040
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-040
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 40 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 15
    mg/kg/vrk jaettuna kolmeen yht\xE4 suureen annokseen. L\xE4\xE4keliuoksen vahvuus
    on 50 mg/ml. Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 12 ml
  - 6 ml
  - 2 ml
  - 4 ml
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "\xC4l\xE4 k\xE4yt\xE4 vuorokausiannosta suoraan millilitralaskussa.
    Selvit\xE4 ensin yhden antokerran l\xE4\xE4keainem\xE4\xE4r\xE4."
  rationale: "Vuorokausiannos on 40 kg \xD7 15 mg/kg/vrk = 600 mg/vrk. Yksi annos
    on 600 mg \xF7 3 = 200 mg. Tarvittava tilavuus on 200 mg \xF7 50 mg/ml = 4 ml."
  professionalPatch: "Monivaiheisessa painoperusteisessa laskussa etene j\xE4rjestyksess\xE4:
    paino \u2192 vuorokausiannos \u2192 kerta-annos \u2192 annettava m\xE4\xE4r\xE4."
