  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-072
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-072
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 0,6 g. Nestem\xE4isen
    l\xE4\xE4kkeen vahvuus on 200 mg/ml. Kuinka monta millilitraa annat?"
  options:
  - 0,3 ml
  - 1,2 ml
  - 3 ml
  - 30 ml
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "M\xE4\xE4r\xE4tty annos ja l\xE4\xE4kkeen vahvuus ovat eri
    yksik\xF6iss\xE4. Yhten\xE4ist\xE4 ne ennen tilavuuden laskemista."
  rationale: "0,6 g = 600 mg. Tarvittava tilavuus on 600 mg \xF7 200 mg/ml = 3 ml."
  professionalPatch: "Tarkista aina ensin m\xE4\xE4r\xE4yksen ja k\xE4ytett\xE4viss\xE4
    olevan l\xE4\xE4kkeen yksik\xF6t."
