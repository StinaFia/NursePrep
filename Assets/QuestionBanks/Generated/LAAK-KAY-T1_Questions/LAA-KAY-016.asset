  tier: 0
  questionText: "Mihin potilasta ohjataan katsomaan silm\xE4tippoja annettaessa?"
  options:
  - Suoraan tiputuspulloon.
  - "Yl\xF6sp\xE4in."
  - "Alasp\xE4in."
  - "Silm\xE4t kiinni."
  infoBubble: 
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Ei aivan oikein. Mieti, mik\xE4 katseen suunta helpottaa silm\xE4tippojen
    annostelua."
  rationale: "Yl\xF6sp\xE4in katsominen helpottaa silm\xE4tippojen annostelua ja
    v\xE4hent\xE4\xE4 r\xE4pyttely\xE4."
  professionalPatch: "Kerro potilaalle rauhallisesti, mit\xE4 olet tekem\xE4ss\xE4.
    Hyv\xE4 ohjaus helpottaa l\xE4\xE4kkeen antamista."
