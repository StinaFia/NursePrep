  tunniste: LAA-LAS-033
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 40 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 2,5
    mg/kg yht\xE4 annosta kohden. Kuinka suuri l\xE4\xE4keannos potilaalle annetaan?"
  options:
  - 16 mg
  - 42,5 mg
  - 1 000 mg
  - 100 mg
  infoBubble: "Kerro potilaan paino m\xE4\xE4r\xE4tyll\xE4 mg/kg-annoksella. Desimaalinen
    annostus ei muuta laskuperiaatetta."
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: Laske 2,5 mg jokaista potilaan 40 painokiloa kohden.
  rationale: "40 kg \xD7 2,5 mg/kg = 100 mg."
  professionalPatch: "Desimaalinen mg/kg-m\xE4\xE4r\xE4 k\xE4sitell\xE4\xE4n samalla
    tavalla kuin kokonaislukuinen mg/kg-m\xE4\xE4r\xE4."
