  m_Name: LAA-PER-013
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-PER-013
  category: LAAK
  theme: PER
  tier: 0
  questionText: "Miksi l\xE4\xE4kkeen antoreitti on t\xE4rke\xE4 tarkistaa ennen
    l\xE4\xE4kkeen antamista?"
  options:
  - "Antoreitti vaikuttaa siihen, miten l\xE4\xE4ke annetaan ja miten se vaikuttaa
    elimist\xF6ss\xE4."
  - "Antoreitti kertoo l\xE4\xE4kkeen valmistajan."
  - "Antoreitti vaikuttaa vain l\xE4\xE4kkeen hintaan."
  - "Antoreitill\xE4 ei ole merkityst\xE4, kun l\xE4\xE4ke on oikea."
  infoBubble: 
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Hyv\xE4 yritys! T\xE4ll\xE4 kertaa oikea vastaus oli toinen.
    Oppiminen rakentuu v\xE4hitellen, eik\xE4 kaikkea tarvitse osata ensimm\xE4isell\xE4
    kerralla. Tutustu rauhassa oikeaan vastaukseen ja sen perusteluun \u2013 seuraavalla
    kerralla osaat jo enemm\xE4n."
  rationale: "L\xE4\xE4kkeen antoreitti vaikuttaa siihen, miten l\xE4\xE4ke annetaan,
    kuinka nopeasti se alkaa vaikuttaa ja miten l\xE4\xE4ke imeytyy elimist\xF6\xF6n.
    Oikean antoreitin varmistaminen on osa turvallista l\xE4\xE4kehoitoa."
  professionalPatch: "Tarkista aina l\xE4\xE4kem\xE4\xE4r\xE4yksest\xE4 my\xF6s l\xE4\xE4kkeen
    antoreitti. Oikea l\xE4\xE4ke v\xE4\xE4r\xE4ll\xE4 antoreitill\xE4 annettuna
    voi aiheuttaa vakavia haittoja."
