  m_Name: LAA-LAS-031
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-031
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilas painaa 60 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 5 mg/kg
    yht\xE4 annosta kohden. Kuinka suuri l\xE4\xE4keannos potilaalle annetaan?"
  options:
  - 12 mg
  - 65 mg
  - 300 mg
  - 600 mg
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Tarkista potilaan paino ja yht\xE4 painokiloa kohden m\xE4\xE4r\xE4tty
    l\xE4\xE4keainem\xE4\xE4r\xE4."
  rationale: "60 kg \xD7 5 mg/kg = 300 mg."
  professionalPatch: "Kun m\xE4\xE4r\xE4ys on mg/kg/annos, kerro potilaan paino mg/kg-annoksella
    saadaksesi yhden annoksen l\xE4\xE4keainem\xE4\xE4r\xE4n."
