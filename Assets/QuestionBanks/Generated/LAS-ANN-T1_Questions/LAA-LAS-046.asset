  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-046
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty antibioottia 500 mg kolme kertaa
    vuorokaudessa seitsem\xE4n vuorokauden ajan. Kuinka paljon l\xE4\xE4keainetta
    koko kuurin aikana tarvitaan?"
  options:
  - 3 500 mg
  - 7 000 mg
  - 10 500 mg
  - 21 000 mg
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Koko kuurin l\xE4\xE4keainem\xE4\xE4r\xE4ss\xE4 tarvitaan sek\xE4
    vuorokauden annosten lukum\xE4\xE4r\xE4 ett\xE4 kuurin pituus."
  rationale: "Vuorokaudessa l\xE4\xE4keainetta tarvitaan 500 mg \xD7 3 = 1 500 mg.
    Seitsem\xE4n vuorokauden aikana tarvitaan 1 500 mg \xD7 7 = 10 500 mg."
  professionalPatch: "Voit tarkistaa kuurilaskun my\xF6s laskemalla ensin antokertojen
    kokonaism\xE4\xE4r\xE4n: 3 \xD7 7 = 21 annosta."
