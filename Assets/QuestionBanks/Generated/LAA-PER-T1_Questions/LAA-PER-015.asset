  m_Name: LAA-PER-015
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-PER-015
  category: LAA
  theme: PER
  tier: 0
  questionText: "Mit\xE4 l\xE4\xE4kemuotoa k\xE4ytet\xE4\xE4n tavallisimmin pitk\xE4kestoiseen
    l\xE4\xE4keaineen imeytymiseen ihon kautta?"
  options:
  - "Silm\xE4tipat"
  - "L\xE4\xE4kelaastari"
  - Oraalineste
  - Ampulli
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Hyv\xE4 yritys! T\xE4ll\xE4 kertaa oikea vastaus oli toinen.
    Oppiminen rakentuu v\xE4hitellen, eik\xE4 kaikkea tarvitse osata ensimm\xE4isell\xE4
    kerralla. Tutustu rauhassa oikeaan vastaukseen ja sen perusteluun \u2013 seuraavalla
    kerralla osaat jo enemm\xE4n."
  rationale: "L\xE4\xE4kelaastari vapauttaa l\xE4\xE4keainetta ihon kautta."
  professionalPatch: "Kirjoita l\xE4\xE4kelaastariin p\xE4iv\xE4m\xE4\xE4r\xE4, jolloin
    laastari on vaihdettu. N\xE4in seuraavan vaihtoajankohdan tarkistaminen on helppoa
    ja l\xE4\xE4kehoito pysyy turvallisena."
