  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-059
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-059
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1 500 KY kaksi
    kertaa vuorokaudessa. L\xE4\xE4kkeen vahvuus on 1 000 KY/ml. Kuinka monta millilitraa
    l\xE4\xE4kett\xE4 tarvitaan yhteens\xE4 vuorokaudessa?"
  options:
  - 1,5 ml
  - 2 ml
  - 3 ml
  - 6 ml
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "\xC4l\xE4 pys\xE4hdy yhden antokerran tilavuuteen, sill\xE4
    kysymyksess\xE4 pyydet\xE4\xE4n koko vuorokauden aikana tarvittavaa m\xE4\xE4r\xE4\xE4."
  rationale: "Yhteen annokseen tarvitaan 1 500 KY \xF7 1 000 KY/ml = 1,5 ml. L\xE4\xE4kett\xE4
    annetaan kaksi kertaa vuorokaudessa, joten 1,5 ml \xD7 2 = 3 ml/vrk."
  professionalPatch: "Tarkista aina, kysyt\xE4\xE4nk\xF6 yhden annoksen vai koko
    vuorokauden l\xE4\xE4kem\xE4\xE4r\xE4\xE4."
