  tunniste: LAA-LAS-002
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1 000 mg. Yksi
    tabletti sis\xE4lt\xE4\xE4 500 mg l\xE4\xE4keainetta. Kuinka monta tablettia
    annat?"
  options:
  - 0,5 tablettia
  - 1 tabletti
  - 2 tablettia
  - 5 tablettia
  infoBubble: "Laske: m\xE4\xE4r\xE4tty annos \xF7 yhden tabletin vahvuus."
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: Tarkista, kuinka monta 500 mg:n annosta tarvitaan, jotta kokonaisannokseksi
    tulee 1 000 mg.
  rationale: "1 000 mg \xF7 500 mg/tabletti = 2 tablettia."
  professionalPatch: "Tarkista lopuksi kertomalla tablettien m\xE4\xE4r\xE4 yhden
    tabletin vahvuudella."
