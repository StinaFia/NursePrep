  tier: 0
  questionText: "Potilas eritt\xE4\xE4 vuorokauden aikana virtsaa 1 500 ml. Lis\xE4ksi
    oksennusta on 200 ml ja dreenieritett\xE4 150 ml. Kuinka paljon teht\xE4v\xE4ss\xE4
    ilmoitettuja nesteit\xE4 menetet\xE4\xE4n yhteens\xE4?"
  options:
  - 1 850 ml
  - 1 650 ml
  - 1 350 ml
  - 1 950 ml
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Huomioi kaikki teht\xE4v\xE4ss\xE4 ilmoitetut nesteiden menetykset."
  rationale: 1 500 ml + 200 ml + 150 ml = 1 850 ml.
  professionalPatch: "Menetettyjen nesteiden kokonaism\xE4\xE4r\xE4 lasketaan kokoamalla
    teht\xE4v\xE4ss\xE4 annetut mitatut menetykset yhteen."
