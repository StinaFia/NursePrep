  m_Name: LAA-LAS-066
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-066
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 30 mg. L\xE4\xE4kkeen
    vahvuus on 20 mg/ml. Valmisteen annostelijalla 1 ml = 20 tippaa. Kuinka monta
    tippaa annat?"
  options:
  - 15 tippaa
  - 20 tippaa
  - 30 tippaa
  - 40 tippaa
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Teht\xE4v\xE4ss\xE4 tarvitaan kaksi vaihetta: mg \u2192 ml
    ja ml \u2192 tipat."
  rationale: "Tarvittava tilavuus on 30 mg \xF7 20 mg/ml = 1,5 ml. Tippam\xE4\xE4r\xE4
    on 1,5 ml \xD7 20 tippaa/ml = 30 tippaa."
  professionalPatch: "Monivaiheisessa tippalaskussa laske ensin l\xE4\xE4kkeen tilavuus
    ja k\xE4yt\xE4 tippakerrointa vasta sen j\xE4lkeen."
