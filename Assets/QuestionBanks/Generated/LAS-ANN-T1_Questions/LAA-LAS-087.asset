  m_Name: LAA-LAS-087
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-087
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilas saa vuorokauden aikana nesteit\xE4 2 750 ml. Nesteit\xE4
    menetet\xE4\xE4n virtsana 1 900 ml ja dreenieritteen\xE4 250 ml. Mik\xE4 on laskennallinen
    nestetasapaino?"
  options:
  - +600 ml
  - "\u2212600 ml"
  - +2 150 ml
  - +850 ml
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "\xC4l\xE4 vertaa saantia vain yhteen menetykseen. Laske ensin
    kaikki ilmoitetut menetykset yhteen."
  rationale: "Menetetyt nesteet ovat 1 900 ml + 250 ml = 2 150 ml. Nestetasapaino
    on 2 750 ml \u2212 2 150 ml = +600 ml."
  professionalPatch: "Monivaiheisessa nestetasapainolaskussa laske saanti ja menetykset
    omiksi kokonaisuuksikseen ennen v\xE4hennyslaskua."
