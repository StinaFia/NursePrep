  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-045
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilas saa l\xE4\xE4kett\xE4 300 mg kaksi kertaa vuorokaudessa
    viiden vuorokauden ajan. Kuinka paljon l\xE4\xE4keainetta potilas saa yhteens\xE4
    viiden vuorokauden aikana?"
  options:
  - 1 500 mg
  - 3 000 mg
  - 600 mg
  - 6 000 mg
  infoBubble: "Laske ensin yhden vuorokauden kokonaisannos ja kerro se hoitop\xE4ivien
    m\xE4\xE4r\xE4ll\xE4."
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Huomioi sek\xE4 annosten m\xE4\xE4r\xE4 vuorokaudessa ett\xE4
    hoidon kesto."
  rationale: "Vuorokausiannos on 300 mg \xD7 2 = 600 mg. Viiden vuorokauden aikana
    l\xE4\xE4keainetta annetaan 600 mg \xD7 5 = 3 000 mg."
  professionalPatch: "Pidemm\xE4n ajanjakson kokonaism\xE4\xE4r\xE4ss\xE4 etene:
    kerta-annos \u2192 vuorokausiannos \u2192 koko hoitojakson m\xE4\xE4r\xE4."
