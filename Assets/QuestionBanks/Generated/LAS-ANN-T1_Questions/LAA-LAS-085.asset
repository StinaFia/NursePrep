  tunniste: LAA-LAS-085
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilas saa vuorokauden aikana nesteit\xE4 yhteens\xE4 2 400 ml
    ja menett\xE4\xE4 nesteit\xE4 yhteens\xE4 1 900 ml. Mik\xE4 on laskennallinen
    nestetasapaino?"
  options:
  - "\u2212500 ml"
  - +500 ml
  - +4 300 ml
  - "\u22124 300 ml"
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Tarkista v\xE4hennyslaskun suunta: saadut nesteet \u2212 menetetyt
    nesteet."
  rationale: "Nestetasapaino = saadut nesteet \u2212 menetetyt nesteet. 2 400 ml
    \u2212 1 900 ml = +500 ml."
  professionalPatch: "Positiivinen tulos tarkoittaa, ett\xE4 laskennallinen nesteiden
    saanti on ollut ilmoitettuja menetyksi\xE4 suurempi."
