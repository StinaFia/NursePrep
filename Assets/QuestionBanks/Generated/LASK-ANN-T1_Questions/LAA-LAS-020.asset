  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-020
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-020
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 0,6 g vuorokaudessa
    jaettuna kolmeen yht\xE4 suureen annokseen. Nestem\xE4isen l\xE4\xE4kkeen vahvuus
    on 100 mg/5 ml. Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 5 ml
  - 10 ml
  - 15 ml
  - 30 ml
  infoBubble: "Muunna ensin vuorokausiannos milligrammoiksi ja jaa se kolmeen annokseen.
    Selvit\xE4 sen j\xE4lkeen tarvittava tilavuus vahvuuden perusteella."
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Etene vaiheittain: yhten\xE4ist\xE4 yksik\xF6t, laske yhden
    antokerran l\xE4\xE4keainem\xE4\xE4r\xE4 ja selvit\xE4 vasta sen j\xE4lkeen annettava
    tilavuus."
  rationale: "0,6 g = 600 mg. Yhden antokerran annos on 600 mg \xF7 3 = 200 mg. Koska
    100 mg vastaa 5 ml:aa, 200 mg vastaa 10 ml:aa."
  professionalPatch: "Kirjoita monivaiheisessa laskussa v\xE4litulokset n\xE4kyviin.
    Se v\xE4hent\xE4\xE4 riski\xE4 k\xE4ytt\xE4\xE4 seuraavassa vaiheessa v\xE4\xE4r\xE4\xE4
    lukua."
