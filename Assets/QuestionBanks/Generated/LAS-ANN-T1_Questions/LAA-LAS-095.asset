  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-095
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-095
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 18 mmol/vrk jaettuna
    kolmeen yht\xE4 suureen annokseen. Liuoksen 4 ml sis\xE4lt\xE4\xE4 8 mmol l\xE4\xE4keainetta.
    Pullossa on 60 ml liuosta. Kuinka moneksi kokonaiseksi vuorokaudeksi pullo riitt\xE4\xE4?"
  options:
  - 5 vrk
  - 10 vrk
  - 15 vrk
  - 20 vrk
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Laske ensin yhden annoksen tarvitsema tilavuus ja siit\xE4
    vuorokausikulutus. Riitt\xE4vyydess\xE4 huomioidaan vain kokonaiset vuorokaudet."
  rationale: "Yksi annos on 18 mmol \xF7 3 = 6 mmol. Koska 4 ml sis\xE4lt\xE4\xE4
    8 mmol, vahvuus on 2 mmol/ml. Yhteen annokseen tarvitaan 6 mmol \xF7 2 mmol/ml
    = 3 ml. Vuorokaudessa tarvitaan 3 ml \xD7 3 = 9 ml. Pullon 60 ml riitt\xE4\xE4
    60 ml \xF7 9 ml/vrk = 6,67 vuorokaudeksi, eli 6 kokonaiseksi vuorokaudeksi."
  professionalPatch: "Riitt\xE4vyyslaskussa viimeinen vaihe on k\xE4ytett\xE4viss\xE4
    oleva kokonaism\xE4\xE4r\xE4 \xF7 vuorokauden kulutus."
