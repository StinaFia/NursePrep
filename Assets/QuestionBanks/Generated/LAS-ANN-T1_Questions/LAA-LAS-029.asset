  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-029
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-029
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "L\xE4\xE4keliuoksen pitoisuus on 0,5 %. Kuinka paljon l\xE4\xE4keainetta
    on 20 ml:ssa liuosta?"
  options:
  - 10 mg
  - 50 mg
  - 500 mg
  - 100 mg
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Etene vaiheittain: selvit\xE4 ensin l\xE4\xE4keainem\xE4\xE4r\xE4
    100 ml:ssa, muuta se milligrammoiksi ja laske sen j\xE4lkeen 20 ml:n sis\xE4lt\xE4m\xE4
    m\xE4\xE4r\xE4."
  rationale: "0,5 % = 0,5 g/100 ml. 0,5 g = 500 mg, joten pitoisuus on 500 mg \xF7
    100 ml = 5 mg/ml. 20 ml \xD7 5 mg/ml = 100 mg."
  professionalPatch: Desimaalinen prosenttipitoisuus ratkaistaan samalla periaatteella
    kuin kokonainen prosenttiluku.
