  m_Name: LAA-LAS-070
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-070
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 24 mg. L\xE4\xE4kkeen
    vahvuus on 16 mg/ml. Valmisteen annostelijalla 1 ml = 20 tippaa. Kuinka monta
    tippaa annat?"
  options:
  - 15 tippaa
  - 30 tippaa
  - 32 tippaa
  - 48 tippaa
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Etene kahdessa vaiheessa: m\xE4\xE4r\xE4tty l\xE4\xE4keainem\xE4\xE4r\xE4
    \u2192 tarvittava tilavuus \u2192 tippam\xE4\xE4r\xE4."
  rationale: "Tarvittava tilavuus on 24 mg \xF7 16 mg/ml = 1,5 ml. Tippam\xE4\xE4r\xE4
    on 1,5 ml \xD7 20 tippaa/ml = 30 tippaa."
  professionalPatch: "Kirjoita monivaiheisessa laskussa v\xE4litulos yksikk\xF6ineen
    n\xE4kyviin ennen seuraavaa muunnosta."
