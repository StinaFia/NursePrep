  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-001
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 500 mg. Yksi tabletti
    sis\xE4lt\xE4\xE4 500 mg l\xE4\xE4keainetta. Kuinka monta tablettia annat?"
  options:
  - 0,5 tablettia
  - 1 tabletti
  - 2 tablettia
  - 5 tablettia
  infoBubble: "Jaa m\xE4\xE4r\xE4tty annos yhden tabletin sis\xE4lt\xE4m\xE4ll\xE4
    l\xE4\xE4keainem\xE4\xE4r\xE4ll\xE4."
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Tarkista m\xE4\xE4r\xE4tty annos ja yhden tabletin vahvuus.
    Laske sen j\xE4lkeen tarvittava tablettim\xE4\xE4r\xE4 uudelleen."
  rationale: "500 mg \xF7 500 mg/tabletti = 1 tabletti."
  professionalPatch: "Kun m\xE4\xE4r\xE4tty annos ja tabletin vahvuus ovat samat,
    tarvitaan yksi tabletti."
