  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-099
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-099
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 25 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 0,02
    g/kg/vrk jaettuna nelj\xE4\xE4n yht\xE4 suureen annokseen. Nestem\xE4isen l\xE4\xE4kkeen
    vahvuus on 50 mg/ml. Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 1,25 ml
  - 2 ml
  - 2,5 ml
  - 10 ml
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "T\xE4ss\xE4 tarvitaan ensin yksikk\xF6muunnos, sitten painoperusteinen
    vuorokausiannos, kerta-annos ja lopuksi tilavuus."
  rationale: "0,02 g/kg/vrk = 20 mg/kg/vrk. Vuorokausiannos on 25 kg \xD7 20 mg/kg/vrk
    = 500 mg/vrk. Yksi annos on 500 mg \xF7 4 = 125 mg. Tilavuus on 125 mg \xF7 50
    mg/ml = 2,5 ml."
  professionalPatch: "\xC4l\xE4 yrit\xE4 ratkaista pitk\xE4\xE4 l\xE4\xE4kelaskua
    yhdell\xE4 kertaa. Kirjoita jokainen v\xE4litulos yksikk\xF6ineen n\xE4kyviin."
