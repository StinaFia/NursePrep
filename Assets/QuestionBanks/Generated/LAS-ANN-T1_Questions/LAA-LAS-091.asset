  m_Name: LAA-LAS-091
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-091
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1,8 g/vrk jaettuna
    kolmeen yht\xE4 suureen annokseen. K\xE4ytett\xE4viss\xE4 on 300 mg:n tabletteja.
    Kuinka monta tablettia annat yhdell\xE4 antokerralla?"
  options:
  - 1 tabletti
  - 2 tablettia
  - 3 tablettia
  - 6 tablettia
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Erota vuorokausiannos yhden antokerran annoksesta ja yhten\xE4ist\xE4
    yksik\xF6t ennen tablettim\xE4\xE4r\xE4n laskemista."
  rationale: "1,8 g = 1 800 mg. Yksi annos on 1 800 mg \xF7 3 = 600 mg. Tablettim\xE4\xE4r\xE4
    on 600 mg \xF7 300 mg/tabletti = 2 tablettia."
  professionalPatch: "Pitk\xE4ss\xE4kin laskussa etene yksi kysymys kerrallaan: paljonko
    vuorokaudessa \u2192 paljonko kerralla \u2192 kuinka monta tablettia."
