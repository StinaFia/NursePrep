  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-030
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-030
  category: LASK
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty 0,3 g l\xE4\xE4kett\xE4. K\xE4ytett\xE4viss\xE4
    olevan l\xE4\xE4keliuoksen pitoisuus on 2 %. Kuinka monta millilitraa annat?"
  options:
  - 30 ml
  - 6 ml
  - 15 ml
  - 150 ml
  infoBubble: "Muunna m\xE4\xE4r\xE4tty annos milligrammoiksi. Selvit\xE4 lis\xE4ksi
    2-prosenttisen liuoksen pitoisuus muodossa mg/ml. Laske lopuksi tarvittava tilavuus."
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "T\xE4ss\xE4 tarvitaan useampi vaihe. Muunna m\xE4\xE4r\xE4tty
    annos milligrammoiksi, selvit\xE4 liuoksen pitoisuus mg/ml ja laske vasta sen
    j\xE4lkeen annettava tilavuus."
  rationale: "M\xE4\xE4r\xE4tty annos 0,3 g = 300 mg. 2 % = 2 g/100 ml = 2 000 mg/100
    ml = 20 mg/ml. Tarvittava tilavuus on 300 mg \xF7 20 mg/ml = 15 ml."
  professionalPatch: "Monivaiheisessa laskussa kirjoita v\xE4litulokset ja niiden
    yksik\xF6t n\xE4kyviin ennen seuraavaan vaiheeseen siirtymist\xE4."
