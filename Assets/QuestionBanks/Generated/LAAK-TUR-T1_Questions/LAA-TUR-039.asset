  tunniste: LAA-TUR-039
  category: LAAK
  theme: TUR
  tier: 0
  questionText: "Miksi l\xE4\xE4kehoidossa on t\xE4rke\xE4\xE4 kertoa my\xF6s l\xE4helt\xE4
    piti -tilanteista?"
  options:
  - "Niist\xE4 voidaan oppia ja ehk\xE4ist\xE4 vastaavia tilanteita tulevaisuudessa"
  - "Niit\xE4 seurataan vain tilastointia varten"
  - "Ne hidastavat ty\xF6skentely\xE4"
  - "Niist\xE4 ei tarvitse kertoa, jos potilaalle ei aiheutunut haittaa"
  infoBubble: 
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "My\xF6s tilanteista, joissa vahinkoa ei syntynyt, voidaan oppia
    paljon."
  rationale: "L\xE4helt\xE4 piti -tilanteiden k\xE4sittely auttaa kehitt\xE4m\xE4\xE4n
    toimintaa ja ehk\xE4isem\xE4\xE4n uusia virheit\xE4."
  professionalPatch: "Turvallinen ty\xF6yhteis\xF6 oppii my\xF6s niist\xE4 tilanteista,
    joissa virhe huomattiin ajoissa."
