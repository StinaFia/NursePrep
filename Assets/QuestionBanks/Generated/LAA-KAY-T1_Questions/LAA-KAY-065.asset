  tunniste: LAA-KAY-065
  aihe: LAA
  aihekori: KAY
  tier: 0
  questionText: "Miksi potilaalle kerrotaan, milloin h\xE4nen tulee ottaa yhteytt\xE4
    terveydenhuoltoon?"
  options:
  - Jotta potilas osaa hakeutua ajoissa hoitoon tarvittaessa.
  - "Jotta l\xE4\xE4kett\xE4 voidaan k\xE4ytt\xE4\xE4 enemm\xE4n."
  - "Jotta l\xE4\xE4kkeen vaikutus kest\xE4\xE4 pidemp\xE4\xE4n."
  - "Jotta kontrollik\xE4yntej\xE4 tulee enemm\xE4n."
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: Ei aivan oikein. Mieti, miksi yhteydenoton ajankohdasta annetaan
    ohjeita.
  rationale: "Potilaan tulee tiet\xE4\xE4, milloin oireet tai l\xE4\xE4kehoito edellytt\xE4v\xE4t
    yhteydenottoa terveydenhuoltoon."
  professionalPatch: "Kerro yhteydenoton syyt selke\xE4sti ja k\xE4yt\xE4 tarvittaessa
    konkreettisia esimerkkej\xE4."
