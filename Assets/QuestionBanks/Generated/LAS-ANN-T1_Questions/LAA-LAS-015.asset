  m_Name: LAA-LAS-015
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-015
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 0,5 mg. Nestem\xE4isen
    l\xE4\xE4kkeen vahvuus on 250 \xB5g/ml. Kuinka monta millilitraa annat?"
  options:
  - 0,5 ml
  - 1 ml
  - 2 ml
  - 20 ml
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Tarkista ensin mg\u2013\xB5g-muunnos. Laske annettava tilavuus
    vasta, kun l\xE4\xE4keainem\xE4\xE4r\xE4t ovat samassa yksik\xF6ss\xE4."
  rationale: "0,5 mg = 500 \xB5g. 500 \xB5g \xF7 250 \xB5g/ml = 2 ml."
  professionalPatch: "Kun m\xE4\xE4r\xE4ys ja vahvuus on ilmoitettu eri yksik\xF6iss\xE4,
    muuta ne ensin samaan yksikk\xF6\xF6n."
