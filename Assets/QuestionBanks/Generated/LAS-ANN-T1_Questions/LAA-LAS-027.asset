  m_Name: LAA-LAS-027
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-027
  category: LAS
  theme: ANN
  tier: 0
  questionText: "L\xE4\xE4keliuoksen pitoisuus on 2 %. Kuinka paljon l\xE4\xE4keainetta
    on 5 ml:ssa liuosta?"
  options:
  - 100 mg
  - 10 mg
  - 20 mg
  - 200 mg
  correctIndices: 00000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Selvit\xE4 ensin prosenttipitoisuudesta yhden millilitran sis\xE4lt\xE4m\xE4
    l\xE4\xE4keainem\xE4\xE4r\xE4 ja laske sen j\xE4lkeen 5 ml:n sis\xE4lt\xE4m\xE4
    m\xE4\xE4r\xE4."
  rationale: "2 % tarkoittaa 2 g/100 ml. 2 g = 2 000 mg, joten pitoisuus on 2 000
    mg \xF7 100 ml = 20 mg/ml. 5 ml \xD7 20 mg/ml = 100 mg."
  professionalPatch: "Prosenttilasku kannattaa pilkkoa vaiheisiin: prosenttipitoisuus
    \u2192 mg/ml \u2192 halutun tilavuuden l\xE4\xE4keainem\xE4\xE4r\xE4."
