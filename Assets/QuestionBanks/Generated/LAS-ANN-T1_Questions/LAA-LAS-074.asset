  m_Name: LAA-LAS-074
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-074
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1 200 mg/vrk jaettuna
    kolmeen yht\xE4 suureen annokseen. K\xE4ytett\xE4viss\xE4 on 200 mg:n tabletteja.
    Kuinka monta tablettia annat yhdell\xE4 antokerralla?"
  options:
  - 1 tabletti
  - 3 tablettia
  - 6 tablettia
  - 2 tablettia
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Selvit\xE4 ensin yhden antokerran l\xE4\xE4keainem\xE4\xE4r\xE4.
    Vuorokausiannosta ei anneta kokonaan yhdell\xE4 kertaa."
  rationale: "Yhden antokerran l\xE4\xE4keannos on 1 200 mg \xF7 3 = 400 mg. Tablettim\xE4\xE4r\xE4
    on 400 mg \xF7 200 mg/tabletti = 2 tablettia."
  professionalPatch: "Kun vuorokausiannos jaetaan useisiin annoksiin, laske kerta-annos
    ennen tablettim\xE4\xE4r\xE4\xE4."
