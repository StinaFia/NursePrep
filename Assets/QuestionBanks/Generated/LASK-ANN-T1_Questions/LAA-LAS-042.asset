  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-042
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-042
  category: LASK
  theme: ANN
  tier: 0
  questionText: "L\xE4\xE4kepakkauksessa on 60 tablettia. Potilas ottaa 2 tablettia
    aamulla ja 1 tabletin illalla. Kuinka moneksi vuorokaudeksi pakkaus riitt\xE4\xE4?"
  options:
  - 30 vrk
  - 15 vrk
  - 20 vrk
  - 60 vrk
  infoBubble: "Laske ensin, kuinka monta tablettia potilas k\xE4ytt\xE4\xE4 yhteens\xE4
    yhden vuorokauden aikana."
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Huomioi sek\xE4 aamu- ett\xE4 ilta-annos ennen pakkauksen riitt\xE4vyyden
    laskemista."
  rationale: "Potilas k\xE4ytt\xE4\xE4 2 + 1 = 3 tablettia vuorokaudessa. 60 tabl.
    \xF7 3 tabl./vrk = 20 vrk."
  professionalPatch: Jos vuorokaudessa on useita annoksia, laske ne ensin yhteen
    vuorokausikulutukseksi.
