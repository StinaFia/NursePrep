  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-005
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 1 g. K\xE4ytett\xE4viss\xE4
    on 250 mg:n tabletteja. Kuinka monta tablettia annat?"
  options:
  - 2 tablettia
  - 2,5 tablettia
  - 4 tablettia
  - 5 tablettia
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "M\xE4\xE4r\xE4tty annos ja tabletin vahvuus ovat eri yksik\xF6iss\xE4.
    Muunna ne ensin samaan yksikk\xF6\xF6n."
  rationale: "1 g = 1 000 mg. 1 000 mg \xF7 250 mg/tabletti = 4 tablettia."
  professionalPatch: "\xC4l\xE4 jaa kesken\xE4\xE4n eri yksik\xF6iss\xE4 olevia l\xE4\xE4keainem\xE4\xE4ri\xE4.
    Tee tarvittava yksikk\xF6muunnos ensin."
