  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-003
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-003
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 250 mg. K\xE4ytett\xE4viss\xE4
    on 500 mg:n tabletteja, jotka voidaan jakaa yht\xE4 suuriin puolikkaisiin. Kuinka
    monta tablettia annat?"
  options:
  - 2 tablettia
  - 1 tabletti
  - 0,5 tablettia
  - 1,5 tablettia
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: Laske, kuinka suuri osa 500 mg:n tabletista tarvitaan 250 mg:n
    annokseen.
  rationale: "250 mg \xF7 500 mg/tabletti = 0,5 tablettia. Teht\xE4v\xE4n mukaan
    tabletti voidaan jakaa yht\xE4 suuriin puolikkaisiin."
  professionalPatch: Tabletin jakaminen varmistetaan aina kyseisen valmisteen ohjeista.
    Kaikkia tabletteja ei saa jakaa.
