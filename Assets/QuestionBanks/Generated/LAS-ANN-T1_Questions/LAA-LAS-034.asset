  m_Name: LAA-LAS-034
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-034
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilas painaa 50 kg. L\xE4\xE4kett\xE4 on m\xE4\xE4r\xE4tty 5 mg/kg
    yht\xE4 annosta kohden. K\xE4ytett\xE4viss\xE4 on 125 mg:n tabletteja. Kuinka
    monta tablettia annat?"
  options:
  - 1 tabletti
  - 2 tablettia
  - 2,5 tablettia
  - 5 tablettia
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Teht\xE4v\xE4ss\xE4 on kaksi vaihetta: laske ensin painon mukainen
    l\xE4\xE4keannos ja vasta sitten tablettim\xE4\xE4r\xE4."
  rationale: "Annos on 50 kg \xD7 5 mg/kg = 250 mg. Tablettim\xE4\xE4r\xE4 on 250
    mg \xF7 125 mg/tabletti = 2 tablettia."
  professionalPatch: "\xC4l\xE4 laske tablettim\xE4\xE4r\xE4\xE4 suoraan potilaan
    painosta. Selvit\xE4 ensin tarvittava l\xE4\xE4keainem\xE4\xE4r\xE4."
