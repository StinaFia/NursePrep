  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-060
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-060
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 24 mmol/vrk jaettuna
    kolmeen yht\xE4 suureen annokseen. Liuoksen 4 ml sis\xE4lt\xE4\xE4 8 mmol l\xE4\xE4keainetta.
    Kuinka monta millilitraa annat yhdell\xE4 antokerralla?"
  options:
  - 2 ml
  - 4 ml
  - 8 ml
  - 12 ml
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "T\xE4ss\xE4 tarvitaan useampi vaihe: vuorokausiannos \u2192
    kerta-annos sek\xE4 mmol/x ml \u2192 mmol/ml. Laske vasta niiden j\xE4lkeen annettava
    tilavuus."
  rationale: "Yhden antokerran m\xE4\xE4r\xE4 on 24 mmol \xF7 3 = 8 mmol. Liuoksen
    vahvuus on 8 mmol \xF7 4 ml = 2 mmol/ml. Tarvittava tilavuus on 8 mmol \xF7 2
    mmol/ml = 4 ml."
  professionalPatch: "Monivaiheisessa laskussa selvit\xE4 erikseen, paljonko tarvitaan
    ja mink\xE4 vahvuista liuos on, ennen kuin lasket annettavan tilavuuden."
