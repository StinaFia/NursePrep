  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 150 mg. Nestem\xE4isen
    l\xE4\xE4kkeen vahvuus on 50 mg/ml. Kuinka monta millilitraa annat?"
  options:
  - 2 ml
  - 2,5 ml
  - 3 ml
  - 5 ml
  infoBubble: "Laske: m\xE4\xE4r\xE4tty l\xE4\xE4keainem\xE4\xE4r\xE4 \xF7 vahvuus."
  correctIndices: 02000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Selvit\xE4, kuinka monta 50 mg:n l\xE4\xE4keannosta tarvitaan
    150 mg:n annokseen."
  rationale: "150 mg \xF7 50 mg/ml = 3 ml."
  professionalPatch: "Voit tarkistaa tuloksen laskemalla 3 ml \xD7 50 mg/ml = 150
    mg."
