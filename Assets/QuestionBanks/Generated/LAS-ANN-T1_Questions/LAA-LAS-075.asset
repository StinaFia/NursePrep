  m_Name: LAA-LAS-075
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-075
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 200 mg. L\xE4\xE4keliuoksen
    pitoisuus on 2 %. Kuinka monta millilitraa annat?"
  options:
  - 2 ml
  - 10 ml
  - 20 ml
  - 100 ml
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Selvit\xE4 ensin prosenttipitoisuudesta liuoksen vahvuus muodossa
    mg/ml."
  rationale: "2 % = 2 g/100 ml = 2 000 mg/100 ml = 20 mg/ml. Tarvittava tilavuus
    on 200 mg \xF7 20 mg/ml = 10 ml."
  professionalPatch: "Prosenttipitoisuus kannattaa muuttaa ensin laskussa k\xE4ytt\xF6kelpoiseen
    muotoon mg/ml."
