  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-097
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-097
  aihe: LAS
  aihekori: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty l\xE4\xE4kett\xE4 750 mg kaksi kertaa
    vuorokaudessa. K\xE4ytett\xE4viss\xE4 on 250 mg:n tabletteja. Pakkauksessa on
    42 tablettia. Kuinka moneksi kokonaiseksi vuorokaudeksi pakkaus riitt\xE4\xE4?"
  options:
  - 5 vrk
  - 7 vrk
  - 14 vrk
  - 21 vrk
  correctIndices: 01000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "\xC4l\xE4 jaa pakkauskokoa suoraan yhden annoksen tablettim\xE4\xE4r\xE4ll\xE4,
    kun l\xE4\xE4kett\xE4 otetaan useammin kuin kerran vuorokaudessa."
  rationale: "Yksi annos tarvitsee 750 mg \xF7 250 mg/tabletti = 3 tablettia. Vuorokaudessa
    tarvitaan 3 \xD7 2 = 6 tablettia. 42 tablettia \xF7 6 tablettia/vrk = 7 vrk."
  professionalPatch: "Riitt\xE4vyydess\xE4 selvit\xE4 ensin todellinen vuorokausikulutus."
