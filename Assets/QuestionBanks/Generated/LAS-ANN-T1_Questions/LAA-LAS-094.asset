  m_Script: {fileID: 11500000, guid: 7b35de3eeb6470245bc92f931c9d823b, type: 3}
  m_Name: LAA-LAS-094
  m_EditorClassIdentifier: Assembly-CSharp::NursingQuiz.Data.QuestionData
  tunniste: LAA-LAS-094
  category: LAS
  theme: ANN
  tier: 0
  questionText: "Potilaalle on m\xE4\xE4r\xE4tty 150 mg l\xE4\xE4kett\xE4 kaksi kertaa
    vuorokaudessa. K\xE4ytett\xE4viss\xE4 on 1-prosenttinen l\xE4\xE4keliuos. Kuinka
    monta millilitraa l\xE4\xE4kett\xE4 tarvitaan yhteens\xE4 vuorokaudessa?"
  options:
  - 15 ml
  - 20 ml
  - 25 ml
  - 30 ml
  correctIndices: 03000000
  correctFeedback: Hienoa! Vastasit oikein.
  incorrectFeedback: "Prosenttipitoisuus t\xE4ytyy ensin muuttaa laskussa k\xE4ytett\xE4v\xE4\xE4n
    vahvuuteen. Muista lis\xE4ksi vuorokauden antokerrat."
  rationale: "1 % = 1 g/100 ml = 1 000 mg/100 ml = 10 mg/ml. Yksi 150 mg:n annos
    tarvitsee 150 mg \xF7 10 mg/ml = 15 ml. Kaksi annosta tarvitsee 15 ml \xD7 2
    = 30 ml/vrk."
  professionalPatch: "Prosenttilaskussa muunna pitoisuus ensin muotoon mg/ml ja jatka
    sen j\xE4lkeen kuten tavallisessa nestem\xE4isen l\xE4\xE4kkeen annoslaskussa."
